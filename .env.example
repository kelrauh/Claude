# Copy to .env and fill in, then `set -a; . ./.env; set +a` before starting Claude Code.
# .env is gitignored. The client secret and any app tokens are secrets; app IDs are not.

# Podio API key: https://podio.com/settings/api
PODIO_CLIENT_ID=your-client-id
PODIO_CLIENT_SECRET=your-client-secret

# --- Option A (recommended): account-wide access -----------------------------
# Run this once; it opens a browser, then writes .podio-token.json (gitignored):
#     uv run --script servers/podio/podio_auth.py
# The API key's registered domain decides the redirect. For a key registered to
# a domain other than localhost, name it and paste the URL back:
#     uv run --script servers/podio/podio_auth.py \
#         --redirect-uri https://claude.ai/podio-callback
# PODIO_REDIRECT_URI=https://claude.ai/podio-callback
# Every app the account can see becomes reachable and nothing below is needed.
# PODIO_TOKEN_FILE=.podio-token.json

# --- Option B: per-app tokens, no browser ------------------------------------
# One entry per app, as alias=app_id:app_token. The alias is what you call the
# app when talking to Claude. Find app_token under the app > wrench menu >
# Developer. For many apps, copy servers/podio/apps.template.json (it already
# has all 23 Imaging app IDs) to apps.json and use PODIO_APPS_FILE instead.
#
# Modular Devices (org 1110222) > Imaging (space 4686720):
# PODIO_APPS=service_calls=16205569:your-app-token
# PODIO_APPS_FILE=servers/podio/apps.json
