# Copy to .env and fill in, then `set -a; . ./.env; set +a` before starting Claude Code.
# .env is gitignored. Client ID/secret and app tokens are secrets; app IDs are not.

# Podio API key: https://podio.com/settings/api
PODIO_CLIENT_ID=your-client-id
PODIO_CLIENT_SECRET=your-client-secret

# One entry per Podio app, as alias=app_id:app_token. The alias is what you call
# the app when talking to Claude. Find app_token under the app > wrench menu >
# Developer (the app_id is on that page too, and in the app's URL).
#
# Modular Devices (org 1110222) > Imaging (space 4686720):
PODIO_APPS=service_calls=16205569:your-app-token
