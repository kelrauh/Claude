# Copy to .env and fill in, then `set -a; . ./.env; set +a` before starting Claude Code.
# Podio API key: https://podio.com/settings/api
PODIO_CLIENT_ID=your-client-id
PODIO_CLIENT_SECRET=your-client-secret

# One entry per Podio app you want reachable, as alias=app_id:app_token.
# Find app_id and app_token under Podio > the app > wrench menu > Developer.
PODIO_APPS=deals=123456789:abcdef0123456789,leads=987654321:fedcba9876543210
